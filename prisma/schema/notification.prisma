model Notification {
  id String @id @default(uuid())

  // Classification details
  type     String
  severity String

  // Content
  title   String
  message String

  // State
  read Boolean @default(false)

  // Polymorphic source tracking
  sourceType String?
  sourceId   String?

  // Timestamps
  createdAt DateTime @default(now())

  @@index([read])
  @@index([type])
  @@index([createdAt])
  @@index([sourceType, sourceId])
}
