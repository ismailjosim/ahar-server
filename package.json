{
  "name": "ahar-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "copy:templates": "node -e \"require('node:fs').cpSync('src/app/utils/templates','dist/app/utils/templates',{recursive:true})\"",
    "build": "tsc && tsc-alias && pnpm copy:templates",
    "vercel-build": "prisma generate && tsc && tsc-alias && pnpm copy:templates",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0",
    "better-auth": "^1.6.20",
    "jose-cjs": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "cors": "^2.8.5",
    "http-status": "^2.1.0",
    "zod": "^4.1.12",
    "dotenv": "^17.2.3",
    "cloudinary": "^2.7.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.10",
    "sslcommerz-lts": "^1.2.0",
    "ejs": "^3.1.10",
    "slugify": "^1.6.9",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.20.6",
    "rimraf": "^6.1.3",
    "prisma": "^7.8.0",
    "eslint": "^10.5.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.65.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.20.0"
  }
}
