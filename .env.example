NODE_ENV="development"
PORT="8000"
BETTER_AUTH_SECRET="demo-better-auth-secret-change-me"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahar_restaurant?schema=public"

# frontend url
FRONTEND_URL="http://localhost:3000"


# Cloudinary credentials
CLOUDINARY_CLOUD_NAME="demo-cloud"
CLOUDINARY_API_KEY="demo-cloudinary-key"
CLOUDINARY_API_SECRET="demo-cloudinary-secret"

# SIMPLE MAIL TRANSFER PROTOCOL(FOR NODEMAILER)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="demo@example.com"
SMTP_PASS="demo-smtp-password"
SMTP_FROM="demo@example.com"

# Super Admin credentials
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASS="demo-admin-password"

# sslCommerz
SSL_STORE_ID="demo-store-id"
SSL_STORE_PASS="demo-store-password"
SSL_PAYMENT_API="https://sandbox.sslcommerz.com/gwprocess/v4/api.php"
SSL_VALIDATION_API="https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php"
SSL_IPN_URL="http://localhost:8000/api/v1/payments/sslcommerz/ipn"

# SSL Commerz backend URLs
SSL_SUCCESS_BACKEND_URL="http://localhost:8000/api/v1/payments/sslcommerz/success"
SSL_FAIL_BACKEND_URL="http://localhost:8000/api/v1/payments/sslcommerz/fail"
SSL_CANCEL_BACKEND_URL="http://localhost:8000/api/v1/payments/sslcommerz/cancel"


# SSL Commerz Frontend URLs
SSL_SUCCESS_FRONTEND_URL="http://localhost:3000/checkout/success"
SSL_FAIL_FRONTEND_URL="http://localhost:3000/checkout/fail"
SSL_CANCEL_FRONTEND_URL="http://localhost:3000/checkout/cancel"


# REDIS
REDIS_USERNAME="default"
REDIS_PASSWORD="demo-redis-password"
REDIS_HOST="localhost"
REDIS_PORT="6379"
